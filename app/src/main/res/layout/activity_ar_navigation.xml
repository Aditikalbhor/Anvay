<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D">

    <!-- 1. Live Camera Preview Feed (TextureView) -->
    <TextureView
        android:id="@+id/cameraTextureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Fallback Camera Simulation Canvas if camera unavailable/permission denied -->
    <View
        android:id="@+id/viewCameraFallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_splash_gradient"
        android:visibility="gone" />

    <!-- 2. Dynamic AR Overlay Graphics Layer -->
    <com.gpp.anvay.ui.AROverlayView
        android:id="@+id/arOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 3. Top Floating Status & Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Pill Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnExitAR"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_ar_pill"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                app:tint="@color/text_on_dark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ar_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/accent_teal" />

                <TextView
                    android:id="@+id/tvARDestination"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Dest: CR 21"
                    android:textColor="@color/text_on_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvARStepCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3/5"
                    android:textColor="@color/accent_teal"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Floor & Mode Status Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvARCurrentFloor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ar_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Floor: 1st Floor"
                android:textColor="@color/text_on_dark"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvARDestFloor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_ar_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Target: 2nd Floor"
                android:textColor="@color/primary_light"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ar_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Demo AR Mode"
                android:textColor="@color/warning_amber"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Staircase Warning Banner (shown dynamically when taking staircase) -->
        <LinearLayout
            android:id="@+id/layoutStaircaseWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ar_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_stairs"
                app:tint="@color/warning_amber" />

            <TextView
                android:id="@+id/tvStaircaseWarningText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Take Staircase S1 to 2nd Floor"
                android:textColor="@color/warning_amber"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Camera Fallback Alert Banner (shown when camera unavailable or permission denied) -->
        <TextView
            android:id="@+id/tvCameraFallbackNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ar_card"
            android:padding="10dp"
            android:text="AR camera preview is active. Simulated route step controls below."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- 4. Bottom Floating Guidance & Action Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- AR Instruction Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ar_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvARInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:text="Proceed forward through the corridor."
                android:textColor="@color/text_on_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnARPrev"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Previous"
                    android:textColor="@color/text_on_dark"
                    app:cornerRadius="12dp"
                    app:strokeColor="#60818CF8" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnARNext"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primary"
                    android:text="Next Step →"
                    android:textColor="@color/text_on_dark"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnARRecalculate"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Restart Route"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnARExit"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Return to Map"
                    android:textColor="@color/accent_teal"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
