<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivSafetyIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_icon"
                android:backgroundTint="@color/emergency_container"
                android:padding="8dp"
                android:src="@drawable/ic_fire"
                app:tint="@color/emergency_red" />

            <TextView
                android:id="@+id/tvSafetyTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Fire Evacuation Protocol"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvSafetySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Immediate actions to take upon hearing the fire alarm or discovering smoke/flames in the building."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Steps container -->
        <TextView
            android:id="@+id/tvSafetySteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/surface_variant"
            android:lineSpacingMultiplier="1.3"
            android:padding="12dp"
            android:text="1. Activate alarm\n2. Evacuate via stairs\n3. Assemble at sports ground"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvAssemblyPoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawableStart="@drawable/ic_exit"
            android:drawablePadding="6dp"
            android:drawableTint="@color/emergency_red"
            android:text="Assembly Point: Open Sports Ground opposite IT Wing"
            android:textColor="@color/emergency_red_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
